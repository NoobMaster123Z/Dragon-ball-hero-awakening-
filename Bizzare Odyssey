-- Get Mobs and Bosses
function GetMobAndBossLists()
	local mobList, bossList, mobCounts = {}, {}, {}
	for _, v in pairs(workspace.Live:GetChildren()) do
		if v:IsA("Model") and v:FindFirstChild("HumanoidRootPart") then
			mobCounts[v.Name] = (mobCounts[v.Name] or 0) + 1
		end
	end
	for name, count in pairs(mobCounts) do
		if count == 1 then
			table.insert(bossList, name)
		else
			table.insert(mobList, name .. " x " .. count)
		end
	end
	return mobList, bossList
end

-- Attack Logic
function Click()
	local root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
	if root then
		ReplicatedStorage.RemoteEvents.BladeCombatRemote:FireServer(false, root.Position, root.CFrame)
	end
end

function Teleport(v)
	if v and v:FindFirstChild("HumanoidRootPart") then
		Player.Character.HumanoidRootPart.CFrame = v.HumanoidRootPart.CFrame * CFrame.new(0, 0, 2)
	end
end

function InstaKill(v)
	if Kill and v:FindFirstChild("Humanoid") then
		v.Humanoid.Health = 0
	end
end

function AutoMob()
	task.spawn(function()
		while _G.AutoMob and SelectedMob do
			for _, v in pairs(workspace.Live:GetChildren()) do
				if v:IsA("Model") and v.Name == SelectedMob then
					Teleport(v)
					Click()
					InstaKill(v)
				end
			end
			task.wait()
		end
	end)
end

function AutoBoss()
	task.spawn(function()
		while _G.AutoBoss and SelectedBoss do
			for _, v in pairs(workspace.Live:GetChildren()) do
				if v:IsA("Model") and v.Name == SelectedBoss then
					Teleport(v)
					Click()
					InstaKill(v)
				end
			end
			task.wait()
		end
	end)
end

function AutoAllBoss()
	task.spawn(function()
		while _G.AutoAllBoss do
			for _, v in pairs(workspace.Live:GetChildren()) do
				if v:IsA("Model") and v:FindFirstChild("HumanoidRootPart") then
					Teleport(v)
					Click()
					InstaKill(v)
				end
			end
			task.wait()
		end
	end)
end

-- Anti-Agro
local antiAgroConnection
function EnableAntiAgro()
	if antiAgroConnection then antiAgroConnection:Disconnect() end
	antiAgroConnection = RunService.Stepped:Connect(function()
		if _G.AntiAgro and Player.Character and Player.Character:FindFirstChild("Player") then
			Player.Character.Player:Destroy()
		end
	end)
end

