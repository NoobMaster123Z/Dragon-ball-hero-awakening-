-- Function to collect all mobs and their quantities from workspace.Live
function getAllMobsWithQuantities()
    local mobCounts = {}
    for _, v in pairs(workspace.Live:GetChildren()) do
        if v:IsA("Model") and v:FindFirstChild("HumanoidRootPart") then
            local mobName = v.Name
            mobCounts[mobName] = (mobCounts[mobName] or 0) + 1
        end
    end

    local mobNamesWithCounts = {}
    for mobName, count in pairs(mobCounts) do
        table.insert(mobNamesWithCounts, mobName .. " x " .. count)
    end
    return mobNamesWithCounts
end

