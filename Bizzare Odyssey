-- Combat Function
function Click()
    local plr = Player.Character.HumanoidRootPart
    local Remote = ReplicatedStoragee.RemoteEvents.BladeCombatRemote
    local args = {
        [1] = false,
        [2] = plr.Position,
        [3] = plr.CFrame
    }
    Remote:FireServer(unpack(args))
end

-- Teleport to Target
function Teleport(ene)
    Player.Character.HumanoidRootPart.CFrame = ene.CFrame * CFrame.new(0, 0, 2)
end

-- Bring Multiple Mobs to Player
function BringMobs()
    local plr = Player.Character.HumanoidRootPart
    for _, v in pairs(workspace.Live:GetChildren()) do
        if v:IsA("Model") and v:FindFirstChild("HumanoidRootPart") then
            -- Check if it's the selected mob
            if v.Name == SelectedMob then
                -- Bring all instances of the selected mob
                v.HumanoidRootPart.CFrame = plr.CFrame * CFrame.new(0, 0, -2)
            end
        end
    end
end

-- Auto Mob Farming
function AutoMob()
    task.spawn(function()
        while task.wait() do
            if not _G.AutoMob then break end
            pcall(function()
                -- Bring all the selected mobs to player if "Bring Mob" is enabled
                if BringMob then
                    BringMobs()
                end
                
                for _, v in pairs(workspace.Live:GetChildren()) do  
                    if v:IsA("Model") and v.Name == SelectedMob and v:FindFirstChild("HumanoidRootPart") then  
                        if v.Humanoid.Health > 0 then  
                            Teleport(v.HumanoidRootPart)  
                            Click()  
                            if Kill then  
                                v.Humanoid.Health = 0  -- Insta kill logic  
                            end  
                        end  
                    end  
                end  
            end)  
        end  
    end)
end

-- Auto Boss Farming
function AutoBoss()
    task.spawn(function()
        while task.wait() do
            if not _G.AutoBoss then break end
            pcall(function()
                for _, v in pairs(workspace.Live:GetChildren()) do
                    if v:IsA("Model") and v.Name == SelectedBoss and v:FindFirstChild("HumanoidRootPart") and v.Humanoid.Health > 0 then
                        Teleport(v.HumanoidRootPart)
                        Click()
                        if Kill then
                            v.Humanoid.Health = 0  -- Insta kill logic for bosses
                        end
                    end
                end
            end)
        end
    end)
end

-- Auto All Boss Farming
function AutoAllBoss()
    task.spawn(function()
        while task.wait() do
            if not _G.AutoAllBoss then break end
            pcall(function()
                for _, v in pairs(workspace.Live:GetChildren()) do
                    if v:IsA("Model") and v.Humanoid.Health > 0 then
                        Teleport(v.HumanoidRootPart)
                        Click()
                        if Kill then
                            v.Humanoid.Health = 0  -- Insta kill logic for all bosses
                        end
                    end
                end
            end)
        end
    end)
end

