if not game:IsLoaded() then game.Loaded:Wait() end

-- Globals
_G.AutoMob = false
_G.AutoBoss = false
local SelectedMob = nil
local SelectedBoss = nil

-- Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Player = Players.LocalPlayer

-- Prevent AFK Kick
Player.Idled:Connect(function()
    game:GetService("VirtualUser"):ClickButton2(Vector2.new())
end)

-- Click Attack
function Click()
    local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    ReplicatedStorage.RemoteEvents.BladeCombatRemote:FireServer(false, hrp.Position, hrp.CFrame)
end

-- Teleport & Kill
function TeleportAndKill(target)
    if target and target:FindFirstChild("HumanoidRootPart") and target:FindFirstChild("Humanoid") then
        Player.Character.HumanoidRootPart.CFrame = target.HumanoidRootPart.CFrame * CFrame.new(0, 0, 2)
        Click()
        target.Humanoid.Health = 0
    end
end

-- Auto Mob
function StartAutoMob()
    task.spawn(function()
        while _G.AutoMob and SelectedMob do
            for _, v in pairs(workspace.Live:GetChildren()) do
                if v.Name == SelectedMob then
                    TeleportAndKill(v)
                end
            end
            task.wait(0.5)
        end
    end)
end

-- Auto Boss
function StartAutoBoss()
    task.spawn(function()
        while _G.AutoBoss and SelectedBoss do
            for _, v in pairs(workspace.Live:GetChildren()) do
                if v.Name == SelectedBoss then
                    TeleportAndKill(v)
                end
            end
            task.wait(0.5)
        end
    end)
end

-- Mob List
function GetMobList()
    local names = {}
    local cache = {}
    for _, v in pairs(workspace.Live:GetChildren()) do
        if v:IsA("Model") and v:FindFirstChild("HumanoidRootPart") then
            if not cache[v.Name] then
                table.insert(names, v.Name)
                cache[v.Name] = true
            end
        end
    end
    return names
end

-- Load Rayfield UI
local Rayfield = loadstring(game:HttpGet("https://raw.githubusercontent.com/shlexware/Rayfield/main/source.lua"))()

local Window = Rayfield:CreateWindow({Name = "Bizarre Odyssey Autofarm", ConfigurationSaving = {Enabled = false}})

local Tab = Window:CreateTab("Farming", nil)

Tab:CreateDropdown({
    Name = "Select Mob",
    Options = GetMobList(),
    Callback = function(v)
        SelectedMob = v
    end
})

Tab:CreateToggle({
    Name = "Auto Mob",
    CurrentValue = false,
    Callback = function(v)
        _G.AutoMob = v
        if v then StartAutoMob() end
    end
})

Tab:CreateDropdown({
    Name = "Select Boss",
    Options = GetMobList(),
    Callback = function(v)
        SelectedBoss = v
    end
})

Tab:CreateToggle({
    Name = "Auto Boss",
    CurrentValue = false,
    Callback = function(v)
        _G.AutoBoss = v
        if v then StartAutoBoss() end
    end
})
