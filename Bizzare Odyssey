                Player.Character.Player:Destroy()
            end
        end)
    end)
end

-- Mob List
function getAllMobsWithQuantities()
    local mobCounts = {}
    for _, v in pairs(workspace.Live:GetChildren()) do
        if v:IsA("Model") and v:FindFirstChild("HumanoidRootPart") then
            local mobName = v.Name
            mobCounts[mobName] = (mobCounts[mobName] or 0) + 1
        end
    end
    local list = {}
    for name, count in pairs(mobCounts) do
        table.insert(list, name .. " x " .. count)
    end
    return list
end

