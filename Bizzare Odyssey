local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local HRP = Player.Character:WaitForChild("HumanoidRootPart")
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Parent = Player:WaitForChild("PlayerGui")

-- Create the main frame
local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 150, 0, 150)
MainFrame.Position = UDim2.new(0.5, -75, 0.5, -75)
MainFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
MainFrame.BackgroundTransparency = 0.5
MainFrame.Parent = ScreenGui

-- Create "Kill All" button
local KillAllButton = Instance.new("TextButton")
KillAllButton.Size = UDim2.new(0, 130, 0, 40)
KillAllButton.Position = UDim2.new(0, 10, 0, 10)
KillAllButton.Text = "Insta Kill"
KillAllButton.TextColor3 = Color3.fromRGB(255, 255, 255)
KillAllButton.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
KillAllButton.Parent = MainFrame

-- Create "Bring Mobs" toggle button
local BringMobsButton = Instance.new("TextButton")
BringMobsButton.Size = UDim2.new(0, 130, 0, 40)
BringMobsButton.Position = UDim2.new(0, 10, 0, 60)
BringMobsButton.Text = "Bring Mobs (Off)"
BringMobsButton.TextColor3 = Color3.fromRGB(255, 255, 255)
BringMobsButton.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
BringMobsButton.Parent = MainFrame

local isBringingMobs = false

-- Function to kill all mobs
local function KillAllMobs()
    for _, mob in pairs(workspace.Live:GetChildren()) do
        if mob:IsA("Model") and mob:FindFirstChild("Humanoid") and mob:FindFirstChild("HumanoidRootPart") then
            -- Insta Kill
            mob.Humanoid.Health = 0
        end
    end
end

-- Function to bring mobs in front of the player within 100 studs radius
local function BringMobs()
    for _, mob in pairs(workspace.Live:GetChildren()) do
        if mob:IsA("Model") and mob:FindFirstChild("Humanoid") and mob:FindFirstChild("HumanoidRootPart") then
            -- Check if mob is within 100 studs
            if (HRP.Position - mob.HumanoidRootPart.Position).Magnitude <= 100 then
                -- Bring mob to the player in front of them at -6
                mob:PivotTo(HRP.CFrame * CFrame.new(0, 0, -6)) -- Position it 6 studs in front of the player
            end
        end
    end
end

-- Button callback for "Insta Kill"
KillAllButton.MouseButton1Click:Connect(function()
    KillAllMobs()
end)

-- Button callback for "Bring Mobs"
BringMobsButton.MouseButton1Click:Connect(function()
    isBringingMobs = not isBringingMobs
    if isBringingMobs then
        BringMobsButton.Text = "Bring Mobs (On)"
    else
        BringMobsButton.Text = "Bring Mobs (Off)"
    end
end)

-- Create a draggable corner to use for dragging the GUI
local dragHandle = Instance.new("Frame")
dragHandle.Size = UDim2.new(0, 20, 0, 20)
dragHandle.Position = UDim2.new(1, -20, 1, -20)
dragHandle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
dragHandle.BackgroundTransparency = 0.5
dragHandle.Parent = MainFrame

-- Draggable functionality for the corner
local dragStart
local startPos
local dragging = false

local function updateDrag(input)
    local delta = input.Position - dragStart
    MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

dragHandle.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    -- Start dragging when the corner is clicked
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                MainFrame.InputChanged:Disconnect(updateDrag)
            end
        end)
        MainFrame.InputChanged:Connect(updateDrag)
    end
end)

-- Hide GUI on player death
Player.CharacterAdded:Connect(function(character)
    local humanoid = character:WaitForChild("Humanoid")
    humanoid.Died:Connect(function()
        ScreenGui:Destroy()
    end)
end)

-- Update bring mobs function if toggled on
game:GetService("RunService").Heartbeat:Connect(function()
    if isBringingMobs then
        BringMobs()
    end
end)
