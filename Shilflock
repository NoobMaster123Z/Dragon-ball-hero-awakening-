-- Crosshair and Bow Aim Assist Script
-- For Roblox executors

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

-- Crosshair settings
local crosshairEnabled = true
local crosshairColor = Color3.fromRGB(0, 255, 0) -- Green crosshair
local crosshairSize = 12
local crosshairThickness = 1
local crosshairGap = 5

-- Aim assist settings (use at your own risk)
local aimAssistEnabled = false
local aimAssistStrength = 0.2 -- Lower values = less noticeable assistance
local aimAssistMaxDistance = 500

-- Create crosshair GUI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "CrosshairGui"
ScreenGui.Parent = game:GetService("CoreGui")

local Frame = Instance.new("Frame")
Frame.Name = "Crosshair"
Frame.Size = UDim2.new(0, crosshairSize * 2 + crosshairGap, 0, crosshairSize * 2 + crosshairGap)
Frame.Position = UDim2.new(0.5, 0, 0.5, 0)
Frame.AnchorPoint = Vector2.new(0.5, 0.5)
Frame.BackgroundTransparency = 1
Frame.Parent = ScreenGui

local function createLine(name, position, size)
    local line = Instance.new("Frame")
    line.Name = name
    line.BackgroundColor3 = crosshairColor
    line.BorderSizePixel = 0
    line.Size = size
    line.Position = position
    line.AnchorPoint = Vector2.new(0.5, 0.5)
    line.Parent = Frame
    return line
end

-- Create crosshair lines
local topLine = createLine("TopLine", 
    UDim2.new(0.5, 0, 0.5, -crosshairGap/2 - crosshairSize), 
    UDim2.new(0, crosshairThickness, 0, crosshairSize))
local bottomLine = createLine("BottomLine", 
    UDim2.new(0.5, 0, 0.5, crosshairGap/2 + crosshairSize), 
    UDim2.new(0, crosshairThickness, 0, crosshairSize))
local leftLine = createLine("LeftLine", 
    UDim2.new(0.5, -crosshairGap/2 - crosshairSize, 0.5, 0), 
    UDim2.new(0, crosshairSize, 0, crosshairThickness))
local rightLine = createLine("RightLine", 
    UDim2.new(0.5, crosshairGap/2 + crosshairSize, 0.5, 0), 
    UDim2.new(0, crosshairSize, 0, crosshairThickness))

-- Function to toggle crosshair
local function toggleCrosshair(enable)
    crosshairEnabled = enable
    Frame.Visible = enable
end

-- Function to calculate projectile drop (adjust for your specific bow)
local function calculateBowDrop(distance)
    -- Adjust these values based on your game's bow mechanics
    local gravity = 196.2 -- Roblox default gravity
    local arrowSpeed = 100 -- Adjust based on your bow's arrow speed
    
    if distance <= 0 then return 0 end
    
    local time = distance / arrowSpeed
    local drop = 0.5 * gravity * time * time
    
    return drop
end

-- Aim assist function (use carefully)
local function findBestTarget()
    if not aimAssistEnabled then return nil end
    
    local character = LocalPlayer.Character
    if not character then return nil end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return nil end
    
    local bestTarget = nil
    local bestAngle = math.rad(5) -- Max angle in radians
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local targetHRP = player.Character:FindFirstChild("HumanoidRootPart")
            if targetHRP then
                local distance = (humanoidRootPart.Position - targetHRP.Position).Magnitude
                if distance <= aimAssistMaxDistance then
                    local screenPoint = workspace.CurrentCamera:WorldToScreenPoint(targetHRP.Position)
                    if screenPoint.Z > 0 then -- If target is in front of camera
                        local mousePos = Vector2.new(Mouse.X, Mouse.Y)
                        local targetPos = Vector2.new(screenPoint.X, screenPoint.Y)
                        local angle = (mousePos - targetPos).Magnitude / 1000 -- Rough angle approximation
                        
                        if angle < bestAngle then
                            bestAngle = angle
                            bestTarget = targetHRP
                        end
                    end
                end
            end
        end
    end
    
    return bestTarget
end

-- Connect to bow firing
local function onBowFired()
    if not crosshairEnabled then return end
    
    -- Get the center of the screen
    local viewportSize = workspace.CurrentCamera.ViewportSize
    local center = Vector2.new(viewportSize.X/2, viewportSize.Y/2)
    
    -- Optional: Add slight aim adjustment for distant targets
    local target = findBestTarget()
    if target and aimAssistEnabled then
        local targetScreenPos = workspace.CurrentCamera:WorldToScreenPoint(target.Position)
        if targetScreenPos.Z > 0 then
            local adjustedPos = Vector2.new(
                center.X + (targetScreenPos.X - center.X) * aimAssistStrength,
                center.Y + (targetScreenPos.Y - center.Y) * aimAssistStrength
            )
            
            -- Simulate mouse movement to adjusted position
            mousemoverel(adjustedPos.X - Mouse.X, adjustedPos.Y - Mouse.Y)
        end
    end
    
    -- For games with projectile drop, you might need to aim slightly higher
    local hitPart, hitPosition = workspace:FindPartOnRayWithIgnoreList(
        Ray.new(
            workspace.CurrentCamera.CFrame.Position,
            workspace.CurrentCamera.CFrame.LookVector * 1000
        ),
        {LocalPlayer.Character}
    )
    
    if hitPosition then
        local distance = (workspace.CurrentCamera.CFrame.Position - hitPosition).Magnitude
        local dropCompensation = calculateBowDrop(distance)
        
        -- Adjust aim upward based on drop calculation
        if dropCompensation > 0 then
            local compensationPixels = dropCompensation * 50 -- Adjust multiplier as needed
            mousemoverel(0, -compensationPixels)
        end
    end
end

-- Listen for bow firing (you'll need to adjust this for your specific game)
-- This is just a template - you'll need to connect to your game's actual bow firing event
local function setupBowListener()
    -- Example: Check if player has a bow equipped and connect to its firing event
    -- This will vary greatly depending on the game you're playing
    LocalPlayer.CharacterAdded:Connect(function(character)
        local humanoid = character:WaitForChild("Humanoid")
        
        humanoid:GetPropertyChangedSignal("Tool"):Connect(function()
            local tool = humanoid:FindFirstChildOfClass("Tool")
            if tool and tool.Name:lower():find("bow") then
                -- This is where you'd connect to the bow's firing event
                -- Since games implement this differently, you'll need to adjust
                tool.Activated:Connect(onBowFired)
            end
        end)
    end)
end

-- Toggle commands
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.P then
        crosshairEnabled = not crosshairEnabled
        Frame.Visible = crosshairEnabled
    elseif input.KeyCode == Enum.KeyCode.O then
        aimAssistEnabled = not aimAssistEnabled
        print("Aim assist:", aimAssistEnabled and "ON" or "OFF")
    end
end)

-- Initialize
setupBowListener()
print("Crosshair script loaded")
print("Press P to toggle crosshair")
print("Press O to toggle aim assist (use at your own risk)")
